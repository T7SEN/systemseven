# --- Discord ---
# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# The channel where go-live announcements are posted.
# Discord: enable Developer Mode (User Settings -> Advanced), right-click the channel -> Copy Channel ID
ANNOUNCE_CHANNEL_ID=

# Optional: a role to ping in the announcement (right-click role -> Copy Role ID). Leave empty for no ping.
MENTION_ROLE_ID=

# --- Twitch ---
# Register an app at https://dev.twitch.tv/console/apps (OAuth redirect URL can be http://localhost)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Comma-separated Twitch login names to watch (the part after twitch.tv/), e.g. "yourname" or "a,b,c"
TWITCH_BROADCASTERS=

# --- Tuning (optional) ---
# How often to check Twitch, in seconds (default 60, minimum 15)
POLL_SECONDS=60

# If a stream drops and comes back within this many minutes, don't announce again (default 15)
RENOTIFY_COOLDOWN_MINUTES=15
