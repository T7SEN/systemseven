{
  "name": "systemseven",
  "version": "0.1.0",
  "private": true,
  "description": "SystemSeven — all-in-one Discord bot",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "check": "tsx src/check.ts",
    "test-notify": "tsx src/testNotify.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sentry/node": "^10.69.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
